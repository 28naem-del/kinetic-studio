// Data desk (crypto): a 30-beat editorial story at 120 BPM, every timing in beats.
// ETH counter -> its sparkline grows into the 30-day line (match) -> the axes hand over to the
// BTC candles (match) -> hard cut to dominance bars -> cut to the stat cards -> the first card
// becomes the watchlist (match) -> hard cut to the closing stat: Bitcoin's month in one figure,
// drawn over the same closes as the candles. Figures are illustrative; pass real ones from your
// data source.
{
  "mode": "data",
  "music": { "style": "pulse", "bpm": 120 },
  "snap": "16th",
  "markers": [
    { "kind": "section", "at": 0, "name": "intro", "energy": 1 },
    { "kind": "section", "at": "chart", "name": "body", "energy": 2 },
    { "kind": "section", "at": "watch", "name": "peak", "energy": 3 },
    { "kind": "section", "at": "close", "name": "outro", "energy": 2 }
  ],
  "scenes": [
    { "type": "counter", "kicker": "Ethereum · spot", "heading": "Ether rallies",
      "prefix": "$", "label": "ETH / USD, 30-day close", "delta_note": "30 days", "count": "2b",
      "spark": { "seed": 10, "n": 30, "start": 3100, "drift": 0.006, "vol": 0.025 }, "dur": "4b" },
    { "type": "line", "kicker": "ETH / USD · 30D", "heading": "Ether's month",
      "series": { "seed": 10, "n": 30, "start": 3100, "drift": 0.006, "vol": 0.025 },
      "first": "1/2b", "draw": "5/2b", "x_labels": ["Oct 1", "Oct 15", "Oct 30"],
      "events": [ { "i": 8, "text": "Monthly low" }, { "i": 24, "text": "ETF inflows" } ],
      "transition": { "kind": "match", "element": "spark" }, "dur": "4b" },
    { "type": "candles", "id": "chart", "kicker": "BTC / USD · 4H", "heading": "Bitcoin vs $70k",
      "seed": 21, "n": 30, "start": 64200, "end": 70840, "vol": 0.012, "level": 70000, "decimals": 0,
      "live": 3, "callout": "Closed above 70,000",
      "transition": { "kind": "match", "element": "plot" }, "dur": "6b" },
    { "type": "bars", "kicker": "Market share", "heading": "Half the market", "suffix": "%", "highlight": "BTC",
      "first": "0b", "stagger": "1/4b", "grow": "1b", "callout": "More than all others combined",
      "items": [ { "label": "BTC", "value": 54, "prev": 51.9 }, { "label": "ETH", "value": 17, "prev": 17.8 },
                 { "label": "USDT", "value": 5, "prev": 5.3 }, { "label": "SOL", "value": 3, "prev": 3.4 },
                 { "label": "Other", "value": 21, "prev": 21.6 } ],
      "transition": "cut", "dur": "4b" },
    { "type": "stat_grid", "kicker": "The week in numbers", "heading": "By the numbers",
      "count": "2b", "stagger": "1/4b",
      "items": [
        { "label": "BTC close", "value": 70840, "prefix": "$", "delta": "+10.3%",
          "spark": { "seed": 21, "n": 24, "start": 64200, "drift": 0.004, "vol": 0.01 } },
        { "label": "ETF net flows", "value": 1.2, "decimals": 1, "prefix": "$", "suffix": "B", "delta": "+$0.4B",
          "spark": { "seed": 5, "n": 24, "start": 0.4, "drift": 0.05, "vol": 0.08 } },
        { "label": "Fear & Greed", "value": 72, "delta": "+9", "gauge": [0, 100] },
        { "label": "Open interest", "value": 38.4, "decimals": 1, "prefix": "$", "suffix": "B", "delta": "-2.1%",
          "spark": { "seed": 8, "n": 24, "start": 40, "drift": -0.002, "vol": 0.01 } }
      ],
      "transition": "cut", "dur": "4b" },
    { "type": "ticker", "id": "watch", "kicker": "Watchlist", "heading": "Live prices",
