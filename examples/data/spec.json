        { "sym": "BTC", "name": "Bitcoin", "price": 70840, "change": 2.4, "decimals": 0 },
        { "sym": "ETH", "name": "Ethereum", "price": 3573, "change": 1.8, "decimals": 0 },
        { "sym": "SOL", "name": "Solana", "price": 148.2, "change": -0.9 },
        { "sym": "XRP", "name": "XRP", "price": 0.612, "change": 3.2, "decimals": 3 },
        { "sym": "DOGE", "name": "Dogecoin", "price": 0.152, "change": -1.6, "decimals": 3 }
      ],
      "transition": { "kind": "match", "element": "card0" }, "dur": "4b" },
    { "type": "counter", "id": "close", "kicker": "The close · 30 days", "heading": "Bitcoin's month",
      "value": 10.3, "decimals": 1, "prefix": "+", "suffix": "%", "color": "accent",
      "label": "BTC / USD, Oct 1 to Oct 30 close", "delta": "+$6,640", "delta_note": "64,200 → 70,840",
